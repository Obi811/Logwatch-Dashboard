# --- LogWatch Dashboard – Beispiel-Konfiguration ---
# Diese Datei als .env kopieren und Werte eintragen. Die echte .env wird NICHT
# eingecheckt (siehe .gitignore).

# PostgreSQL-Verbindung (von der Plattform bereitgestellt).
# Format: postgresql://benutzer:passwort@host:5432/datenbank
DATABASE_URL=postgresql://USER:PASSWORT@HOST:5432/DBNAME

# Seed-Admin (wird beim ersten Start angelegt, falls noch kein Benutzer existiert).
# NUR Platzhalter hier – echtes Passwort ausschließlich in der lokalen .env!
ADMIN_USER=admin
ADMIN_PASSWORD=BITTE-AENDERN

# Shared Secret / Upload-Token, mit dem der Windows-Client Fehlerberichte hochlädt.
# Muss im Client exakt gleich eingetragen werden.
UPLOAD_TOKEN=BITTE-EIN-LANGES-ZUFAELLIGES-TOKEN-SETZEN

# Schlüssel zum Signieren der Session-Cookies (lang & zufällig).
SECRET_KEY=BITTE-EIN-LANGES-ZUFAELLIGES-SECRET-SETZEN

# Öffentlicher Host (optional, für Links/Logs). Ohne Schema.
# PUBLIC_HOST=logwatch-xxxx.abacusai.cloud

# Verzeichnis für hochgeladene Logdateien (Standard: ./data/uploads)
# UPLOAD_DIR=data/uploads

# Erlaubte CORS-Origins für die App-/REST-API (/api/v1), komma-separiert.
# Standard "*" (jeder Ursprung). Für den Produktivbetrieb eng setzen.
# API_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- E-Mail-Versand (SMTP) ---------------------------------------------------
# Optionaler Fallback, falls KEINE SMTP-Konfiguration im Dashboard
# (Menü „SMTP", gespeichert in der DB) hinterlegt ist. Die DB-Konfiguration hat
# Vorrang. Ohne Host ist der Versand deaktiviert.
# Das Passwort wird in der DB Fernet-verschlüsselt gespeichert (abgeleitet aus
# SECRET_KEY) – hier als Env nur Klartext für den reinen Fallback-Fall.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=logwatch@example.com
# SMTP_PASSWORD=BITTE-SETZEN
# SMTP_FROM_EMAIL=logwatch@example.com
# SMTP_FROM_NAME=LogWatch Dashboard
# Sicherheit: starttls | ssl | none
# SMTP_SECURITY=starttls
