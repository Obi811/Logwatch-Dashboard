[Unit]
Description=LogWatch Dashboard (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target
# /home/ubuntu mountet spät im Boot – nie vor Vorhandensein der Projektdateien starten.
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/logwatch-dashboard
ExecStart=/home/ubuntu/logwatch-dashboard/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8070 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
